{
  "name": "annie-receptionist",
  "version": "0.1.0",
  "private": true,
  "description": "UK Trades AI Receptionist V1 \u2014 middleware, config and tooling for the GHL native Voice AI agent",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:failure": "vitest run tests/failure",
    "test:security": "vitest run tests/security",
    "validate:config": "tsx tools/validate-config.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run validate:config && npm run prompt:build",
    "prompt:build": "tsx tools/compile-prompt.ts",
    "prompt:release-check": "tsx tools/compile-prompt.ts --release",
    "test:prompt": "vitest run tests/prompt",
    "test:conversation": "vitest run tests/conversation",
    "score": "tsx tools/score-transcripts.ts",
    "demo:logs": "tail -n 0 -f build/logs/annie-api.log | pino-pretty --ignore pid,hostname,service,env,version --translateTime SYS:HH:MM:ss",
    "test:mutation": "stryker run",
    "test:fuzz": "vitest run tests/fuzz",
    "test:load": "node load/actions-load.mjs",
    "ops:call-review": "tsx tools/ops/call-review.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/under-pressure": "^9.2.0",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "undici": "^7.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
