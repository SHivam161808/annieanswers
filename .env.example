# Copy to .env (never commit .env). One env file per GHL sub-account: .env, .env.qa, .env.demo.
APP_ENV=dev
RELEASE_VERSION=0.0.0-dev
PORT=8080
LOG_LEVEL=info
REDIS_URL=redis://127.0.0.1:6379/3
# Comma-separated: current secret first, previous during rotation. 32+ random characters each.
WEBHOOK_SECRETS=replace-with-32-plus-random-characters-000000
METRICS_TOKEN=replace-with-32-plus-random-characters-111111
CLIENT_CONFIG_DIR=config/clients
ACTION_DEADLINE_MS=1800
BODY_LIMIT_BYTES=16384
RATE_LIMIT_PER_MINUTE=600
MAX_EVENT_LOOP_DELAY_MS=250
SHUTDOWN_GRACE_MS=10000
# GHL sub-account Private Integration token (Settings > Private Integrations) and its location id.
GHL_PRIVATE_TOKEN=pit-replace-me
GHL_LOCATION_ID=replace-with-20-character-location-id
